OPENAI_BASE_URL = https://base.url.here
OPENAI_API_KEY = yourkey
OPENAI_MODEL = deepseek-v4-flash   

# 轻量模型：做梦沉淀等后台任务用（可指向更便宜的模型；不配置则回退主模型）
# LITE_MODEL = deepseek-v4-flash
# LITE_MODEL_BASE_URL = https://opencode.ai/zen/go/v1/
# LITE_MODEL_API_KEY = yourkey

# Tavily配置：智能搜索时使用
TAVILY_API_KEY = tavily_key_here

# image_identifier - 视觉模型配置
IMAGE_BASE_URL = https://base.url.here
IMAGE_API_KEY = yourkey
IMAGE_MODEL = qwen3.5-flash

# github 推送配置（已弃用）
GITHUB_TOKEN = ghp_XXX

# kb-query 知识库配置
# 存储后端: json / sqlite / postgres（默认 json 零依赖）
KB_STORE=json

# Embedding 模型（OpenAI 兼容格式，支持 Ollama / DeepSeek / OpenAI 等）
# Ollama 本地示例（推荐）:
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3
# 向量维度（可选。bge-m3=1024, nomic-embed-text=768, text-embedding-3-small=1536）
# 留空则自动探测，填了可以跳过探测步骤
EMBEDDING_DIM=1024


# 上下文整理选项
MAX_CONTEXT_TOKENS=100000
COMPRESS_TARGET_RATIO=0.75
ROUND_RATIO_THRESHOLD=0.5

# DeepSeek 示例（取消注释以下行）:
# EMBEDDING_BASE_URL=https://api.deepseek.cn/v1
# EMBEDDING_API_KEY=sk-your-deepseek-key
# EMBEDDING_MODEL=deepseek-embedding

# OpenAI 示例:
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-your-openai-key
# EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL 专用（仅 KB_STORE=postgres 时需要）
# PG_URL=postgresql://user:pass@localhost:5432/seek_kb