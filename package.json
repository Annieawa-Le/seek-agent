{
  "name": "seek-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Seek Agent - AI Programming Assistant",
  "type": "module",
  "main": "electron/main.js",
  "author": "Seek Agent",
  "license": "MIT",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:webui": "node scripts/dev-electron.mjs",
    "dev:electron": "electron .",
    "build:agent": "node scripts/build-agent.mjs",
    "build:renderer": "cd electron/renderer && npx vite build",
    "build:pack": "node scripts/build-agent.mjs && electron-builder --win",
    "build:pack:dir": "node scripts/build-agent.mjs && electron-builder --win --dir",
    "build:ext": "cd extension && pnpm build",
    "build": "pnpm build:agent && pnpm build:ext"
  },
  "build": {
    "appId": "com.seekagent.app",
    "productName": "Seek Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/main.js",
      "electron/preload.cjs",
      "electron/renderer/dist/**/*",
      "dist/release/agent/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/release/agent",
        "to": "agent",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": null,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "unicode": true,
      "language": "2052",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "shortcutName": "Seek Agent",
      "displayLanguageSelector": true
    },
    "asar": false,
    "electronDist": "./node_modules/.pnpm/electron@42.5.0/node_modules/electron/dist",
    "compression": "maximum",
    "removePackageScripts": true
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-builder",
      "electron-winstaller",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "@ai-sdk/deepseek": "^2.0.35",
    "@ai-sdk/mcp": "^2.0.3",
    "@ai-sdk/openai": "^3.0.66",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tavily/core": "^0.7.6",
    "ai": "^6.0.193",
    "dotenv": "^17.4.2",
    "iconv-lite": "^0.7.2",
    "image-size": "^2.0.2",
    "ink": "^7.1.1",
    "ink-use-mouse": "^1.0.0",
    "parse5": "^8.0.1",
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "react": "19.2.7",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.17",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3"
  }
}
